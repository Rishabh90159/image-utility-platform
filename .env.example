# Production domain, no trailing slash. Used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: public contact address shown on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: enable cookieless Plausible analytics by setting your Plausible site domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: custom Plausible script URL (for self-hosted Plausible).
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
